# Provider selected at startup: anthropic (default) | openai | mock.
# LLM_PROVIDER=anthropic

# OpenAI is opt-in and supports gpt-5.6-sol only. Credentials stay on the server.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-sol
# Production uses the official endpoint; OPENAI_BASE_URL is not supported.

# Anthropic credentials. The SDK also honours ANTHROPIC_AUTH_TOKEN and an
# `ant auth login` profile, so this can stay unset if you use those.
ANTHROPIC_API_KEY=

# Drive the run with the scripted mock instead of a model — no key needed.
# `npm run demo` sets this for you.
# MOCK_LLM=1

# Reported-usage limit for one run, in USD (> 0). The run stops when reached.
# Requests already in flight may overshoot; reported usage is retained after cancellation.
RUN_BUDGET_USD=5

# Cumulative ceiling across every run this process starts, in USD (> 0).
# Default: 4 × RUN_BUDGET_USD. Once reached, /api/run/start is refused (403)
# until the server is restarted.
# LIFETIME_BUDGET_USD=20

# Per-agent model overrides. Default is claude-opus-5, or OPENAI_MODEL when OpenAI is selected.
# AGENT_MODEL_ATLAS=claude-opus-5
# AGENT_MODEL_VECTOR=claude-opus-5
# AGENT_MODEL_FORGE=claude-opus-5
# AGENT_MODEL_PROBE=claude-opus-5
# AGENT_MODEL_SENTRY=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max; OpenAI also supports none.
# EFFORT=high

# Model calls one agent may make per wake (guards against tool loops).
# MAX_ITERATIONS_PER_TURN=24

# Wakes one agent may take per run.
# MAX_TURNS_PER_AGENT=60

# Multiplier on the mock driver's pacing: 1 = designed timing, 0 = instant.
# MOCK_SPEED=1

# Start the run when the server boots. Default: on for MOCK_LLM, off otherwise.
# AUTO_START=1

# Server port (the Vite dev server proxies /api here).
# PORT=8787

# Default local mode only allows loopback bind/Host. A remote bind requires
# session mode with a validated operator key and HTTPS public origin.
# HOST=127.0.0.1
# AUTH_MODE=local

# Session mode: use runtime secret storage for a random >=32-byte unpadded
# base64url operator key (up to 128 characters). This is NOT a model API key.
# PUBLIC_ORIGIN=https://console.example
# AGENT_CHAT_OPERATOR_TOKEN=
# AUTH_SESSION_TTL_SECONDS=28800
# Sessions are in memory and lost on restart. Exact Origin is required for
# cookie mutations. TLS terminates at a trusted proxy preserving Host.
# Local mode is not protection against a proxy that rewrites Host to loopback.

# Serve a built client from this directory. Default: ./dist when it exists.
# STATIC_DIR=dist
