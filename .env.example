# Anthropic credentials. The SDK also honours ANTHROPIC_AUTH_TOKEN and an
# `ant auth login` profile, so this can stay unset if you use those.
ANTHROPIC_API_KEY=

# Drive the run with the scripted mock instead of a model — no key needed.
# `npm run demo` sets this for you.
# MOCK_LLM=1

# Hard cost ceiling for one run, in USD (> 0). The run stops when it is reached.
RUN_BUDGET_USD=5

# Per-agent model overrides. Default is claude-opus-5 for every agent.
# AGENT_MODEL_ATLAS=claude-opus-5
# AGENT_MODEL_VECTOR=claude-opus-5
# AGENT_MODEL_FORGE=claude-opus-5
# AGENT_MODEL_PROBE=claude-opus-5
# AGENT_MODEL_SENTRY=claude-opus-5

# Reasoning effort for every agent: low | medium | high | xhigh | max
# EFFORT=high

# Model calls one agent may make per wake (guards against tool loops).
# MAX_ITERATIONS_PER_TURN=24

# Wakes one agent may take per run.
# MAX_TURNS_PER_AGENT=60

# Multiplier on the mock driver's pacing: 1 = designed timing, 0 = instant.
# MOCK_SPEED=1

# Start the run when the server boots. Default: on for MOCK_LLM, off otherwise.
# AUTO_START=1

# Server port (the Vite dev server proxies /api here).
# PORT=8787

# Serve a built client from this directory. Default: ./dist when it exists.
# STATIC_DIR=dist
